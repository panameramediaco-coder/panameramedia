<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:-apple-system,Inter,Helvetica,Arial,sans-serif;background:#0a0a0a;color:#0a0a0a}
.breaking{background:#0a0a0a;color:#fff;text-align:center;padding:8px 16px;font-size:9px;font-weight:800;letter-spacing:1.5px;border-bottom:1px solid #222}
.page-bg{max-width:1200px;margin:0 auto;background:#fff;padding:0 0 24px;min-height:100vh}
header{border-bottom:1.5px solid #0a0a0a;position:sticky;top:0;background:#fff;z-index:20}
.topbar{max-width:1200px;margin:0 auto;padding:14px 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:-1.2px;font-size:18px;text-decoration:none;color:#0a0a0a}
.contact-btn{font-size:9px;letter-spacing:1.5px;font-weight:900;text-decoration:none;color:#fff;background:#0a0a0a;border-radius:999px;padding:8px 14px}
.container{max-width:1200px;margin:0 auto;padding:20px 20px 0}
.links{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 0 20px}
.link-box{border:1.5px solid #0a0a0a;border-radius:10px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#0a0a0a;font-weight:700;font-size:13px}
.link-box small{display:block;font-size:9px;letter-spacing:2px;opacity:0.5;font-weight:800}
.hero-slider{position:relative;border:1.5px solid #0a0a0a;border-radius:14px;overflow:hidden;background:#fff;min-height:380px}
.slides{position:relative;width:100%;min-height:380px}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 0.6s ease;display:grid;grid-template-columns:1.15fr 0.85fr;pointer-events:none}
.slide.active{opacity:1;pointer-events:auto}
.slide-media{position:relative;overflow:hidden;background:#111;display:flex;align-items:center;justify-content:center}
.slide-media img{width:100%;height:100%;object-fit:cover;display:block}
.slide-media img.contain{object-fit:contain !important;background:#111 !important;object-position:center top !important}
.slide-label{position:absolute;bottom:10px;left:10px;right:10px;background:#0a0a0a;color:#fff;font-size:6.5px;font-weight:800;letter-spacing:1px;padding:5px 8px;border-radius:6px;display:flex;justify-content:space-between}
.slide-content{background:#fff;padding:24px 20px;display:flex;flex-direction:column;justify-content:center;border-left:1.5px solid #0a0a0a}
.slide-content .k{font-size:7px;font-weight:900;letter-spacing:1.5px;margin-bottom:10px;display:inline-block;background:#0a0a0a;color:#fff;padding:4px 8px;border-radius:999px;width:fit-content}
.slide-content .k.pink{background:#FF2E93}.slide-content .k.blue{background:#38B6FF}.slide-content .k.yellow{background:#FFD60A;color:#0a0a0a}
.slide-content h2{font-size:30px;font-weight:900;letter-spacing:-1.2px;line-height:0.88;margin-bottom:10px;text-transform:uppercase}
.slide-content p{font-size:11px;line-height:1.4;font-weight:600;opacity:0.7;margin-bottom:14px}
.slide-content .btn{display:inline-flex;background:#0a0a0a;color:#fff;border-radius:999px;padding:8px 14px;font-size:9px;font-weight:900;letter-spacing:1px;width:fit-content;text-decoration:none}
.dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:10;background:rgba(255,255,255,0.92);border:1.5px solid #0a0a0a;border-radius:999px;padding:7px 12px}
.dot{width:28px;height:6px;border-radius:999px;background:#0a0a0a;opacity:0.2;cursor:pointer;transition:all 0.3s}
.dot.active{opacity:1;background:#FF2E93;width:36px}
.manifesto-bar{margin:16px 0 18px;font-size:7px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;opacity:0.4;text-align:center;line-height:1.3}
.two-col{display:grid;grid-template-columns:1.15fr 0.85fr;gap:14px;margin-top:10px}
.col{border:1.5px solid #0a0a0a;border-radius:14px;padding:14px;background:#fff}
.col-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;border-bottom:1px solid #eee;padding-bottom:8px}
.col-header h2{font-size:13px;font-weight:900;letter-spacing:-0.3px;text-transform:uppercase}
.side{font-size:6.5px;font-weight:800;letter-spacing:0.8px;opacity:0.5;text-align:right;line-height:1.2}
.b-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.b-card{background:#0a0a0a;color:#fff;border-radius:10px;padding:12px 8px;text-align:center;min-height:74px;display:flex;flex-direction:column;justify-content:center;text-decoration:none}
.b-card .t{font-weight:900;font-size:8.5px;line-height:1.05;letter-spacing:-0.2px}
.b-card .d{font-size:5.5px;opacity:0.55;margin-top:5px;letter-spacing:0.8px;font-weight:700}
.b-card.white{background:#fff;color:#0a0a0a;border:1.5px solid #0a0a0a}
.article-wrap{border:1.5px solid #0a0a0a;border-radius:14px;padding:24px 20px;margin-top:14px;background:#fff}
.article-wrap h1{font-size:26px;font-weight:900;letter-spacing:-1px;line-height:0.9;margin-bottom:6px}
.article-wrap h2{font-size:13px;font-style:italic;opacity:0.6;margin-bottom:12px}
.article-meta{font-size:8px;font-weight:800;letter-spacing:1.5px;opacity:0.4;margin-bottom:12px;text-transform:uppercase}
.article-body{font-size:13px;line-height:1.6;opacity:0.9}
.article-body p{margin-bottom:10px}
.article-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:16px 0}
.article-gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;border:1.5px solid #0a0a0a;display:block}
footer{border-top:1.5px solid #0a0a0a;padding:20px;text-align:center;font-size:9px;letter-spacing:1.5px;margin-top:40px;opacity:0.6}
@media(max-width:900px){.two-col{grid-template-columns:1fr}.slide{grid-template-columns:1fr}.slide-content{border-left:none;border-top:1.5px solid #0a0a0a;padding:18px}.slide-content h2{font-size:24px}.hero-slider{min-height:560px}.slides{min-height:560px}.b-grid{grid-template-columns:1fr 1fr}.links{grid-template-columns:1fr}}
</style>
