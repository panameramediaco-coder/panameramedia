<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,Inter,Helvetica,Arial,sans-serif;background:#fff;color:#0a0a0a}
.breaking{background:#0a0a0a;color:#fff;text-align:center;padding:8px 16px;font-size:10px;font-weight:800;letter-spacing:2px}
header{border-bottom:1.5px solid #0a0a0a;position:sticky;top:0;background:#fff;z-index:10}
.topbar{max-width:1100px;margin:0 auto;padding:16px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:-1.5px;font-size:20px;text-decoration:none;color:#0a0a0a}
.container{max-width:1100px;margin:0 auto;padding:24px 24px 48px}
.links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0 40px}
.link-box{border:1.5px solid #0a0a0a;border-radius:12px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#0a0a0a;font-weight:700}
.link-box small{display:block;font-size:10px;letter-spacing:2px;opacity:0.5;font-weight:800}
.section-label{margin:48px 0 8px;font-size:10px;font-weight:800;letter-spacing:2px;text-transform:uppercase;opacity:0.5}
.section-title{font-size:28px;font-weight:900;letter-spacing:-1.5px;line-height:0.9;margin-bottom:16px}
.pink{color:#FF2E93}.blue{color:#38B6FF}.yellow{color:#FFD60A}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;margin-bottom:24px}
.card{border:1.5px solid #0a0a0a;border-radius:16px;overflow:hidden;text-decoration:none;color:#0a0a0a;display:block;background:#fff;transition:transform 0.15s}
.card:hover{transform:translateY(-2px)}
.card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:#111}
.card-black{background:#0a0a0a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;letter-spacing:1px;aspect-ratio:16/10;text-align:center;padding:16px}
.card-info{padding:12px 14px}
.card-title{font-weight:800;font-size:14px;margin-bottom:2px}
.card-sub{font-size:12px;opacity:0.6;line-height:1.3}
.badge{display:inline-block;background:#FF2E93;color:#fff;font-size:9px;font-weight:900;letter-spacing:1.5px;padding:4px 8px;border-radius:999px;margin-bottom:8px}
.hero-slider{position:relative;border:1.5px solid #0a0a0a;border-radius:16px;overflow:hidden;background:#0a0a0a;aspect-ratio:16/7;min-height:420px;margin-bottom:40px}
.slides{position:relative;width:100%;height:100%}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 0.6s ease;display:grid;grid-template-columns:1.15fr 0.85fr;pointer-events:none}
.slide.active{opacity:1;pointer-events:auto}
.slide-media{position:relative;overflow:hidden;background:#111}
.slide-media img{width:100%;height:100%;object-fit:cover;display:block}
.slide-label{position:absolute;bottom:12px;left:12px;right:12px;background:#0a0a0a;color:#fff;font-size:7px;font-weight:800;letter-spacing:1px;padding:6px 8px;border-radius:6px;display:flex;justify-content:space-between}
.slide-content{background:#fff;padding:28px 24px;display:flex;flex-direction:column;justify-content:center}
.slide-content .k{font-size:7px;font-weight:900;letter-spacing:1.5px;margin-bottom:8px;display:inline-block;background:#0a0a0a;color:#fff;padding:4px 8px;border-radius:999px}
.slide-content .k.pink{background:#FF2E93}.slide-content .k.blue{background:#38B6FF}.slide-content .k.yellow{background:#FFD60A;color:#0a0a0a}
.slide-content h2{font-size:32px;font-weight:900;letter-spacing:-1.2px;line-height:0.9;margin-bottom:8px;text-transform:uppercase}
.slide-content p{font-size:11px;line-height:1.4;font-weight:600;opacity:0.7;margin-bottom:12px}
.slide-content .btn{display:inline-flex;background:#0a0a0a;color:#fff;border-radius:999px;padding:8px 14px;font-size:9px;font-weight:900;letter-spacing:1px;width:fit-content;text-decoration:none}
.dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:5}
.dot{width:22px;height:4px;border-radius:999px;background:rgba(255,255,255,0.3);cursor:pointer;transition:all 0.3s}
.dot.active{background:#fff;width:28px}
.article-wrap{border:1.5px solid #0a0a0a;border-radius:16px;padding:32px 28px;margin-top:24px;max-width:780px;background:#fff}
.article-wrap h1{font-size:36px;font-weight:900;letter-spacing:-1.5px;line-height:0.9;margin-bottom:8px}
.article-wrap h2{font-size:18px;font-weight:400;font-style:italic;opacity:0.7;margin-bottom:20px;line-height:1.3}
.article-meta{font-size:10px;font-weight:800;letter-spacing:2px;opacity:0.5;margin-bottom:24px;text-transform:uppercase}
.article-body{font-size:16px;line-height:1.75;opacity:0.9}
.article-body p{margin-bottom:18px}
.article-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}
.article-gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;border:1.5px solid #0a0a0a;display:block}
footer{border-top:1.5px solid #0a0a0a;padding:24px;text-align:center;font-size:10px;letter-spacing:2px;margin-top:48px}
@media(max-width:900px){.slide{grid-template-columns:1fr}.slide-content{padding:18px}.slide-content h2{font-size:24px}.hero-slider{aspect-ratio:auto;min-height:540px}.links{grid-template-columns:1fr}.section-title{font-size:24px}.article-gallery{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}
</style>
</head>
