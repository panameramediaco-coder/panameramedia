<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>PANAMERA MEDIA CO</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#EAF4FF;color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,"SF Pro";min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
  .wrap{max-width:480px;width:100%;text-align:center;background:white;padding:48px 32px;border-radius:32px;box-shadow:0 20px 60px rgba(0,0,0,0.08);border:1px solid rgba(0,0,0,0.06)}
  h1{font-size:42px;font-weight:900;letter-spacing:-2px;line-height:0.9;color:#0a0a0a}
  .sub{margin:18px 0 32px;opacity:0.6;font-size:14px;letter-spacing:0.5px;color:#0a0a0a;line-height:1.5}
  .links{display:flex;flex-direction:column;gap:14px}
  .links a{display:flex;align-items:center;justify-content:center;gap:10px;padding:18px;border-radius:100px;text-decoration:none;font-weight:700;font-size:15px;border:1.5px solid #0a0a0a;background:#0a0a0a;color:#fff;transition:.2s}
  .links a:hover{transform:scale(1.02);background:#111}
  .links a.apple{background:#0a0a0a;color:#fff}
  .links a.light{background:#fff;color:#0a0a0a;border-color:#ddd}
  .links a.light:hover{background:#f5f5f5}
  .footer{margin-top:32px;font-size:11px;letter-spacing:3px;opacity:0.3;color:#0a0a0a}
</style>
</head>
<body>
  <div class="wrap">
    <h1>PANAMERA MEDIA CO</h1>
    <div class="sub">Buscamos el Amor al Arte en Nuestra Latinoamérica<br/>PANAMERA SESIONES</div>
    <div class="links">
      <a class="apple" href="https://podcasts.apple.com/us/podcast/panamera-sesiones/id6790205633" target="_blank">🎙️ Apple Podcasts</a>
      <a class="light" href="https://www.youtube.com/@panameramedia" target="_blank">▶️ YouTube</a>
      <a class="light" href="https://www.instagram.com/panameramediaco/" target="_blank">📸 Instagram</a>
    </div>
    <div class="footer">PANAMERAMEDIA.COM</div>
  </div>
</body>
</html>
