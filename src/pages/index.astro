<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Panamera Media Co — El Panamera 2026</title>
<meta name="description" content="Panamera Media Co — Film Festival Coverage, New Music, Sesiones En Vivo" />
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,Inter,Helvetica,Arial,sans-serif;background:#fff;color:#0a0a0a;-webkit-font-smoothing:antialiased}
.breaking{background:#0a0a0a;color:#fff;text-align:center;padding:10px 16px;font-size:10px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase}
header{border-bottom:1.5px solid #0a0a0a;position:sticky;top:0;background:rgba(255,255,255,0.98);backdrop-filter:blur(8px);z-index:50}
.topbar{max-width:1180px;margin:0 auto;padding:18px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:-1.8px;font-size:22px;text-decoration:none;color:#0a0a0a}
.container{max-width:1180px;margin:0 auto;padding:24px 24px 64px}
.links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0 48px}
.link-box{border:1.5px solid #0a0a0a;border-radius:14px;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#0a0a0a;font-weight:800;transition:all 0.15s}
.link-box:hover{transform:translateY(-1px);background:#0a0a0a;color:#fff}
.link-box small{display:block;font-size:10px;letter-spacing:2px;opacity:0.5;font-weight:800;margin-bottom:2px}
.section-label{margin:56px 0 10px;font-size:10px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;opacity:0.45}
.section-title{font-size:30px;font-weight:900;letter-spacing:-1.6px;line-height:0.9;margin-bottom:18px;text-transform:uppercase}
.pink{color:#FF2E93}.blue{color:#38B6FF}.yellow{color:#FFD60A}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px;margin-bottom:28px}
.card{border:1.5px solid #0a0a0a;border-radius:18px;overflow:hidden;text-decoration:none;color:#0a0a0a;display:block;background:#fff;transition:all 0.2s}
.card:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(0,0,0,0.08)}
.card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:#111}
.card-black{background:#0a0a0a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;letter-spacing:1px;aspect-ratio:16/10;font-size:18px}
.card-info{padding:14px 16px}
.card-title{font-weight:900;font-size:15px;margin-bottom:3px;letter-spacing:-0.2px}
.card-sub{font-size:12.5px;opacity:0.6;line-height:1.35}
.badge{display:inline-block;color:#fff;font-size:9px;font-weight:900;letter-spacing:1.5px;padding:5px 10px;border-radius:999px;margin-bottom:10px;text-transform:uppercase}
.badge-pink{background:#FF2E93}.badge-blue{background:#38B6FF}.badge-black{background:#0a0a0a}
footer{border-top:1.5px solid #0a0a0a;padding:32px 24px;text-align:center;font-size:10px;letter-spacing:2px;opacity:0.5;margin-top:64px;line-height:1.6}
footer a{color:#0a0a0a;text-decoration:none;font-weight:800}
@media(max-width:800px){.links{grid-template-columns:1fr}.section-title{font-size:26px}.grid{grid-template-columns:1fr}.topbar{padding:14px 18px}.container{padding:18px 18px 48px}}
</style>
</head>
<body>
