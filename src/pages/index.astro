<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Panamera Media Co</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,Inter,Helvetica,Arial;background:#fff;color:#0a0a0a}
.breaking{background:#0a0a0a;color:#fff;text-align:center;padding:8px 16px;font-size:10px;font-weight:800;letter-spacing:2px}
header{border-bottom:1.5px solid #0a0a0a;position:sticky;top:0;background:#fff;z-index:10}
.topbar{max-width:1100px;margin:0 auto;padding:14px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:-1.5px;font-size:20px;text-decoration:none;color:#0a0a0a}
.container{max-width:1100px;margin:0 auto;padding:24px 24px 48px}
.section-label{margin:40px 0 12px;font-size:10px;font-weight:800;letter-spacing:2px;text-transform:uppercase;opacity:0.5}
.links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0 32px}
.link-box{border:1.5px solid #0a0a0a;border-radius:12px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#0a0a0a;font-weight:700}
.link-box small{display:block;font-size:10px;letter-spacing:2px;opacity:0.5;font-weight:800}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{border:1.5px solid #0a0a0a;border-radius:16px;overflow:hidden;background:#fff;text-decoration:none;color:#0a0a0a;display:block;transition:transform 0.15s}
.card:hover{transform:translateY(-3px)}
.card img{width:100%;height:380px;object-fit:cover;display:block;background:#111}
.card-content{padding:14px 16px}
.card-content small{font-size:9px;letter-spacing:1.5px;opacity:0.5;font-weight:800;display:block;margin-bottom:4px}
.card-content h4{font-size:14px;font-weight:900;letter-spacing:-0.3px;line-height:1.2}
.badge{display:inline-block;font-size:8px;font-weight:900;letter-spacing:1px;padding:4px 8px;border-radius:999px;margin-bottom:8px;color:#fff}
.badge-blue{background:#38B6FF}.badge-pink{background:#FF2E93}.badge-yellow{background:#FFD60A;color:#0a0a0a}.badge-black{background:#0a0a0a}
footer{border-top:1.5px solid #0a0a0a;padding:24px;text-align:center;margin-top:48px}
.contact-btn{display:inline-flex;border:1.5px solid #0a0a0a;border-radius:999px;padding:10px 18px;text-decoration:none;color:#0a0a0a;font-weight:800;font-size:11px;letter-spacing:1px}
.contact-btn:hover{background:#0a0a0a;color:#fff}
@media(max-width:700px){.links{grid-template-columns:1fr}.card img{height:320px}}
/* PERFECT FIT FIX FOR THE GRID UNPLUGGED */
.card.grid-perfect img{height:380px;object-fit:cover;object-position:top center;background:#f5f0e6}
</style>
</head>
<body>
<div class="breaking">PANAMERA MEDIA CO • VENICE 2026 • HAMPTONS 2026 • BOLERO PUNK</div>
